apps/server/

# Runtime artifacts
apps/desktop/data/api-port
apps/desktop/data/api-token
# TICKET_1334: the Service API runtime-role claim, written next to the two
# discovery files above and released on shutdown. Same class of per-machine
# runtime artifact -- it records a live pid, so a committed copy is meaningless
# to any other checkout and looks like a stale claim to the reaper.
apps/desktop/data/api-runtime.lock
apps/desktop/data/oauth-token
apps/desktop/logs/*.backup

# Database files (SQLite runtime: db, WAL journal, shared-memory, backups)
apps/desktop/data/*.db
apps/desktop/data/*.db-shm
apps/desktop/data/*.db-wal
apps/desktop/data/*.db.backup.*
apps/desktop/data/*.db.bak.*
apps/desktop/data/*.db.*.bak
apps/desktop/data/*.db.corrupt.*
apps/desktop/data/*.db.corrupt.*-shm
apps/desktop/data/*.db.corrupt.*-wal
apps/desktop/data/*.db.pre-purge*
apps/desktop/data/*.db.pre_*
apps/desktop/data/backups/

# CatBoost training byproducts (catboost_info/) -- never commit
catboost_info/

# TICKET_1303_1_10: Playwright per-run artifacts. Kept OUT of test-results/,
# which holds committed P8/P9 acceptance evidence Playwright would clear.
apps/desktop/playwright-artifacts/

# TICKET_1340 audit scan artifacts (HTML/JSON reports); the .md analyses are tracked
reports/*
!reports/*.md
