{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "operation": {
      "$ref": "#/$defs/__schema0"
    },
    "workflowId": {
      "$ref": "#/$defs/__schema1"
    },
    "inputReferenceIds": {
      "$ref": "#/$defs/__schema2"
    },
    "candidate": {
      "$ref": "#/$defs/__schema3"
    },
    "training": {
      "$ref": "#/$defs/__schema4"
    },
    "evaluation": {
      "$ref": "#/$defs/__schema5"
    },
    "artifact": {
      "$ref": "#/$defs/__schema6"
    }
  },
  "required": [
    "operation",
    "workflowId",
    "inputReferenceIds",
    "candidate",
    "training",
    "evaluation",
    "artifact"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "type": "string",
      "const": "discover"
    },
    "__schema1": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "__schema2": {
      "minItems": 1,
      "maxItems": 256,
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema1"
      }
    },
    "__schema3": {
      "type": "object",
      "properties": {
        "candidateId": {
          "$ref": "#/$defs/__schema1"
        },
        "featureColumn": {
          "$ref": "#/$defs/__schema1"
        },
        "targetColumn": {
          "$ref": "#/$defs/__schema1"
        }
      },
      "required": [
        "candidateId",
        "featureColumn",
        "targetColumn"
      ],
      "additionalProperties": false
    },
    "__schema4": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "ridge",
            "python-ridge-v1"
          ]
        },
        "l2Regularization": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "kind",
        "l2Regularization"
      ],
      "additionalProperties": false
    },
    "__schema5": {
      "type": "object",
      "properties": {
        "minimumRows": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "minimumRows"
      ],
      "additionalProperties": false
    },
    "__schema6": {
      "type": "object",
      "properties": {
        "artifactId": {
          "$ref": "#/$defs/__schema1"
        }
      },
      "required": [
        "artifactId"
      ],
      "additionalProperties": false
    }
  }
}
