        "factor-mining.formula.generate",
        "factor-mining.formula.persist"
      ]
    },
    "__schema3": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "__schema4": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048
    },
    "__schema5": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "__schema6": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    }
  }
