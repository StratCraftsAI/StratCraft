{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "contractVersion": {
      "$ref": "#/$defs/__schema0"
    },
    "requestId": {
      "$ref": "#/$defs/__schema1"
    },
    "operationId": {
      "$ref": "#/$defs/__schema2"
    },
    "sequence": {
      "$ref": "#/$defs/__schema3"
    },
    "phase": {
      "$ref": "#/$defs/__schema1"
    },
    "message": {
      "$ref": "#/$defs/__schema4"
    },
    "completedUnits": {
      "$ref": "#/$defs/__schema5"
    },
    "totalUnits": {
      "$ref": "#/$defs/__schema6"
    }
  },
  "required": [
    "contractVersion",
    "requestId",
    "operationId",
    "sequence",
    "phase",
    "message"
  ],
  "additionalProperties": false,
  "$defs": {
