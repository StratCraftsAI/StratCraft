{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "operation": {
      "$ref": "#/$defs/__schema0"
    },
    "workflowId": {
      "$ref": "#/$defs/__schema1"
    },
    "resourceDecisionId": {
      "$ref": "#/$defs/__schema1"
    },
    "inputLineage": {
      "$ref": "#/$defs/__schema2"
    },
    "candidateCount": {
      "$ref": "#/$defs/__schema5"
    },
    "trainedCandidateCount": {
      "$ref": "#/$defs/__schema5"
    },
    "evaluatedCandidateCount": {
      "$ref": "#/$defs/__schema5"
    },
    "selectedCandidateId": {
      "$ref": "#/$defs/__schema1"
    },
    "metrics": {
      "$ref": "#/$defs/__schema6"
    },
    "publishedArtifactIds": {
      "$ref": "#/$defs/__schema7"
    }
  },
  "required": [
    "operation",
    "workflowId",
    "resourceDecisionId",
    "inputLineage",
    "candidateCount",
    "trainedCandidateCount",
    "evaluatedCandidateCount",
    "selectedCandidateId",
    "metrics",
    "publishedArtifactIds"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "type": "string",
      "const": "discover"
    },
    "__schema1": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "__schema2": {
      "minItems": 1,
      "maxItems": 256,
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema3"
      }
    },
    "__schema3": {
      "type": "object",
      "properties": {
        "referenceId": {
          "$ref": "#/$defs/__schema1"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "requestedWindow": {
          "type": "object",
          "properties": {
            "startUtc": {
              "$ref": "#/$defs/__schema4"
            },
            "endUtc": {
              "$ref": "#/$defs/__schema4"
            }
          },
          "required": [
            "startUtc",
            "endUtc"
          ],
          "additionalProperties": false
        },
        "windowPushdownDecisionId": {
          "$ref": "#/$defs/__schema1"
        }
      },
      "required": [
        "referenceId",
        "sha256",
        "requestedWindow",
        "windowPushdownDecisionId"
      ],
      "additionalProperties": false
    },
    "__schema4": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "__schema5": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "__schema6": {
      "type": "object",
      "properties": {
        "observations": {
          "$ref": "#/$defs/__schema5"
        },
        "intercept": {
          "type": "number"
        },
        "slope": {
          "type": "number"
        },
        "correlation": {
          "type": "number",
          "minimum": -1,
          "maximum": 1
        },
        "meanSquaredError": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "observations",
        "intercept",
        "slope",
        "correlation",
        "meanSquaredError"
      ],
      "additionalProperties": false
    },
    "__schema7": {
      "minItems": 1,
      "maxItems": 256,
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema1"
      }
    }
  }
}
