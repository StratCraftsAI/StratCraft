{
  "name": "@StratCraft/secure-store",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "description": "Cross-process versioned credential-key lifecycle, AES-256-GCM envelopes, rotation, and recovery over SQLite",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@napi-rs/keyring": "^1.3.0",
    "@StratCraft/types": "workspace:*"
  },
  "optionalDependencies": {
    "@napi-rs/keyring-linux-x64-gnu": "1.3.0",
    "@napi-rs/keyring-linux-x64-musl": "1.3.0",
    "@napi-rs/keyring-darwin-arm64": "1.3.0",
    "@napi-rs/keyring-darwin-x64": "1.3.0",
    "@napi-rs/keyring-win32-x64-msvc": "1.3.0"
  },
  "devDependencies": {
    "@types/node": "^25.3.0",
    "tsup": "^8.0.0",
    "typescript": "^5.3.0",
    "vitest": "^1.0.0"
  }
}
