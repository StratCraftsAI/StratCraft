{
  "name": "@StratCraft/research-environment",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "description": "TICKET_1335 L3: durable research-environment job store, long-held advisory lock, and crash reconciliation. Shared owner of job truth consumed by Electron main, the Service API, and the standalone MCP server so no surface keeps a private registry.",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@StratCraft/types": "workspace:*"
  },
  "devDependencies": {
    "@StratCraft/db-migrations": "workspace:*",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.3.0",
    "@vitest/coverage-v8": "^1.0.0",
    "better-sqlite3": "^12.6.2",
    "tsup": "^8.0.0",
    "typescript": "^5.3.0",
    "vitest": "^1.0.0"
  }
}
