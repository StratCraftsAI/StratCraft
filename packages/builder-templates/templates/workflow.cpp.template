// TICKET_783_5: Rolling vote-history window. Stores the last `Lookback` bars'
// per-component vote sign as int8_t (+1 EnterLong / -1 EnterShort / 0 Hold).
// Consumed by `rolling_corr` to compute pairwise Pearson correlation between
// component vote streams; the aggregator's `correlation_adjusted` method then
// down-weights components whose votes are redundant with others. Cheap by
// construction: int8_t storage, O(1) push, fixed-size stack-allocated.
template <std::size_t Lookback>
class RollingVote {
public:
    void push(std::int8_t v) noexcept {
        buf_[head_] = v;
        head_ = (head_ + 1) % Lookback;
        if (head_ == 0) {
            full_ = true;
        }
        if (!full_) {
            ++size_;
        }
    }

    // Number of samples currently in the window (0 .. Lookback).
    [[nodiscard]] std::size_t size() const noexcept {
        return full_ ? Lookback : size_;
    }

    // Read the i-th most recent sample (0 = newest). Returns 0 when out of range.
    [[nodiscard]] std::int8_t at(std::size_t i) const noexcept {
        const std::size_t n = size();
        if (i >= n) return 0;
        // head_ points at the next write slot; newest is at (head_ - 1) mod L.
        const std::size_t idx = (head_ + Lookback - 1 - i) % Lookback;
        return buf_[idx];
    }

private:
    std::array<std::int8_t, Lookback> buf_{};
    std::size_t head_ = 0;
    std::size_t size_ = 0;
    bool full_ = false;
};

// TICKET_783_5: Pearson correlation of two vote streams over their common
// in-window length. Zero-variance series (e.g. one component always Hold)
// yield rho = 0 by convention -- NaN-safe so callers can sum `|rho|` without
// special-casing. N_min < 2 also yields 0 (insufficient data).
template <std::size_t Lookback>
[[nodiscard]] inline double rolling_corr(
    const RollingVote<Lookback>& a,
    const RollingVote<Lookback>& b) noexcept {
    const std::size_t n = std::min(a.size(), b.size());
    if (n < 2) {
        return 0.0;
    }
    double sum_a = 0.0, sum_b = 0.0, sum_aa = 0.0, sum_bb = 0.0, sum_ab = 0.0;
    for (std::size_t i = 0; i < n; ++i) {
        const double av = static_cast<double>(a.at(i));
        const double bv = static_cast<double>(b.at(i));
        sum_a += av;
        sum_b += bv;
        sum_aa += av * av;
        sum_bb += bv * bv;
        sum_ab += av * bv;
    }
    const double dn = static_cast<double>(n);
    const double mean_a = sum_a / dn;
    const double mean_b = sum_b / dn;
    const double var_a = (sum_aa / dn) - (mean_a * mean_a);
    const double var_b = (sum_bb / dn) - (mean_b * mean_b);
    if (var_a <= 0.0 || var_b <= 0.0) {
        return 0.0;
    }
    const double cov = (sum_ab / dn) - (mean_a * mean_b);
    return cov / std::sqrt(var_a * var_b);
}

// TICKET_783_3: Rolling shadow-PnL window for per-entry-component Sharpe
// estimation. `push(r)` records one bar's shadow return for the component
// (sign(vote) * bar_return); only non-Hold votes (r == 0 from a Hold is also
// recorded so the denominator still advances). `non_zero_count()` is what the
// aggregator uses as `n_rolling`. `sharpe()` returns 0 when `non_zero_count()
// < 2` (no usable estimate).
template <std::size_t Lookback>
class RollingPnl {
public:
    void push(double r, bool was_active) noexcept {
        if (full_) {
            // Evict the oldest sample before overwriting.
            const double oldest = buf_[head_];
            sum_ -= oldest;
            sum_sq_ -= oldest * oldest;
            if (active_buf_[head_]) {
                --non_zero_;
            }
        }
        buf_[head_] = r;
        active_buf_[head_] = was_active;
        sum_ += r;
        sum_sq_ += r * r;
        if (was_active) {
            ++non_zero_;
        }
        head_ = (head_ + 1) % Lookback;
        if (head_ == 0) {
            full_ = true;
        }
    }

    [[nodiscard]] std::int64_t non_zero_count() const noexcept {
        return non_zero_;
    }

    [[nodiscard]] std::size_t size() const noexcept {
        return full_ ? Lookback : head_;
    }

    [[nodiscard]] double sharpe() const noexcept {
        const std::size_t n = size();
        if (n < 2 || non_zero_ < 2) {
            return 0.0;
        }
        const double dn = static_cast<double>(n);
        const double mean = sum_ / dn;
        const double var = (sum_sq_ / dn) - (mean * mean);
        if (var <= 0.0) {
            return 0.0;
        }
        return mean / std::sqrt(var);
    }

private:
    std::array<double, Lookback> buf_{};
    std::array<bool, Lookback> active_buf_{};
    double sum_ = 0.0;
    double sum_sq_ = 0.0;
    std::int64_t non_zero_ = 0;
    std::size_t head_ = 0;
    bool full_ = false;
};

