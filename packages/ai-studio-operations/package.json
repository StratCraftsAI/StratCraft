{
  "name": "@StratCraft/ai-studio-operations",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "description": "Electron-free AI Studio workflow contract and vibing-chat protocol shared by Electron Main and the standalone MCP server",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./vibing-chat-protocol": {
      "types": "./dist/vibing-chat-protocol.d.ts",
      "import": "./dist/vibing-chat-protocol.mjs",
      "require": "./dist/vibing-chat-protocol.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/vibing-chat-protocol.ts --format cjs,esm --dts",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@types/node": "^25.3.0",
    "@vitest/coverage-v8": "^1.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.3.0",
    "vitest": "^1.0.0"
  }
}
