{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "declaration": false,
    "sourceMap": true,
    "outDir": "./dist",
    "jsx": "react-jsx",
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "paths": {
      "react": ["./node_modules/@types/react"],
      "react/*": ["./node_modules/@types/react/*"],
      "@shared/types": ["../../apps/desktop/src/shared/types/index.ts"],
      "@shared/types/*": ["../../apps/desktop/src/shared/types/*"],
      "@shared/utils/*": ["../../apps/desktop/src/shared/utils/*"],
      "@shared/constants/*": ["../../apps/desktop/src/shared/constants/*"],
      "@shared/data/*": ["../../apps/desktop/src/shared/data/*"],
      "@host/secrets": [
        "../../apps/desktop/src/renderer/components/settings/SecretsPanel/host-public.d.ts"
      ],
      "@/*": ["./src/*"]
    }
  },
  "include": ["src/**/*", "src/types/**/*.d.ts", "assets/**/*.json"],
  "exclude": ["node_modules", "dist"]
}
