{
  "name": "@StratCraft/mcp-server",
  "version": "1.0.0",
  "license": "Apache-2.0",
  "description": "StratCraft MCP Server for AI Agent integration",
  "private": true,
  "scripts": {
    "postinstall": "npm rebuild better-sqlite3",
    "build": "tsc",
    "start": "node dist/mcp-server.js",
    "start:http": "node dist/mcp-server.js --http",
    "generate:capability-matrix": "node scripts/generate-electron-capability-docs.mjs",
    "check:capability-matrix": "node scripts/generate-electron-capability-docs.mjs --check",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "1.3.0",
    "@anthropic-ai/claude-agent-sdk": "0.3.220",
    "@github/copilot-sdk": "1.0.8",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@simplewebauthn/server": "^13.3.2",
    "ajv": "^8.17.1",
    "better-sqlite3": "^12.6.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.3.0",
    "@vitest/coverage-v8": "^3.2.4",
    "typescript": "^5.9.3",
    "vitest": "^3.1.1"
  }
}
