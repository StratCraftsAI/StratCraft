        "index": "src/main/public-index.ts",
        "trace-copy-worker": "src/main/trace-copy-worker.ts"
      },
      "preload": {
        "index": "src/preload/index.ts"
      },
      "renderer": {
        "index": "src/renderer/public-index.html"
      }
    }
  }
}
