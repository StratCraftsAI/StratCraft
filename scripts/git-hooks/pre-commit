#!/bin/bash
# TICKET_534 Root Cause Fix: Pre-commit lockfile validation
# This hook validates pnpm-lock.yaml integrity before commit

set -e

# Color codes
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

# Check if pnpm-lock.yaml is being committed
if git diff --cached --name-only | grep -q "pnpm-lock.yaml"; then
  echo "${YELLOW}[TICKET_534] Validating pnpm-lock.yaml integrity...${NC}"

  # 1. Check for merge conflict markers
  if grep -q "^<<<<<<< " pnpm-lock.yaml || \
     grep -q "^=======" pnpm-lock.yaml || \
     grep -q "^>>>>>>> " pnpm-lock.yaml; then
    echo "${RED}❌ ERROR: pnpm-lock.yaml contains merge conflict markers${NC}"
    echo "${RED}   Resolve merge conflicts and regenerate lockfile with:${NC}"
    echo "${RED}   pnpm install --no-frozen-lockfile${NC}"
    exit 1
  fi

  # 2. Validate lockfile can be parsed
  if ! pnpm install --frozen-lockfile --dry-run > /dev/null 2>&1; then
    echo "${RED}❌ ERROR: pnpm-lock.yaml is corrupted or out of sync${NC}"
    echo "${RED}   Run 'pnpm install --no-frozen-lockfile' to fix${NC}"
    exit 1
  fi

  # 3. Check for missing git dependency entries
  GIT_DEPS=$(find . -name "package.json" -not -path "*/node_modules/*" -exec grep -h "git+" {} \; 2>/dev/null | grep -o "git+[^\"]*" || true)

  if [ -n "$GIT_DEPS" ]; then
    MISSING_DEPS=""
    while IFS= read -r dep; do
      DEP_HASH=$(echo "$dep" | grep -o "#[a-f0-9]*" || true)
      if [ -n "$DEP_HASH" ]; then
        if ! grep -q "$DEP_HASH" pnpm-lock.yaml; then
          MISSING_DEPS="$MISSING_DEPS\n  - $dep"
        fi
      fi
    done <<< "$GIT_DEPS"

    if [ -n "$MISSING_DEPS" ]; then
      echo "${RED}❌ ERROR: Missing lockfile entries for git dependencies:${NC}"
      echo "${RED}$MISSING_DEPS${NC}"
      echo "${RED}   Run 'pnpm install --no-frozen-lockfile' to fix${NC}"
      exit 1
    fi
  fi

  echo "${GREEN}✅ pnpm-lock.yaml validation passed${NC}"
fi

# TICKET_535 Root Cause Fix: Check for hardcoded error messages in tests
if git diff --cached --name-only | grep -q "\.test\.ts$"; then
  echo "${YELLOW}[TICKET_535] Checking for hardcoded error messages in tests...${NC}"

  STAGED_TESTS=$(git diff --cached --name-only | grep "\.test\.ts$")
  HARDCODED_ERRORS=""

  for test_file in $STAGED_TESTS; do
    # Check for toThrow/toContain with hardcoded strings (not MSG_ constants)
    if grep -nE "toThrow\(['\"](?!MSG_)" "$test_file" > /dev/null 2>&1 || \
       grep -nE "toContain\(['\"](?!MSG_)" "$test_file" | grep -E "error|Error" > /dev/null 2>&1; then
      HARDCODED_ERRORS="$HARDCODED_ERRORS\n  - $test_file"
    fi
  done

  if [ -n "$HARDCODED_ERRORS" ]; then
    echo "${YELLOW}⚠️  WARNING: Tests may contain hardcoded error messages:${NC}"
    echo "${YELLOW}$HARDCODED_ERRORS${NC}"
    echo "${YELLOW}   Consider using ERROR_MESSAGES constants instead${NC}"
    echo "${YELLOW}   Example: toThrow(ERROR_MESSAGES.PLUGIN_ACCESS_DENIED)${NC}"
    # Don't fail, just warn (we'll enforce this after full migration)
  fi
fi

exit 0
