{
  "schemaVersion": 1,
  "canonicalPublicLicense": "Apache-2.0",
  "allowedDependencyLicenses": [
    "0BSD",
    "Apache-2.0",
    "Artistic-2.0",
    "BSD",
    "BSD-2-Clause",
    "BSD-3-Clause",
    "BlueOak-1.0.0",
    "BSL-1.0",
    "CC-BY-3.0",
    "CC-BY-4.0",
    "CC0-1.0",
    "ISC",
    "MIT",
    "MIT-0",
    "Python-2.0",
    "Unlicense",
    "W3C",
    "WTFPL",
    "Zlib"
  ],
  "dependencyLicenseOverrides": {
    "buffers@0.1.1": "MIT",
    "commander@2.2.0": "MIT"
  },
  "leakageRules": [
    {
      "id": "private-repository",
      "pattern": "\\bStratCraft-dev\\b",
      "flags": "i",
      "description": "private repository name",
      "excludedPaths": [
        "scripts/check_public_content.sh"
      ]
    },
    {
      "id": "private-document-tree",
      "pattern": "(?:^|[/'\"`])docs/(?:private|back-source)(?:/|\\b)",
      "flags": "i",
      "description": "private documentation tree",
      "excludedPaths": [
        ".gitignore",
        "scripts/check_code_compliance.sh",
        "scripts/ci/public-repository-gates.mjs",
        "scripts/ci/__tests__/public-repository-gates.test.mjs"
      ]
    },
    {
      "id": "developer-workspace-path",
      "pattern": "(?:/data/ws/|/home/[^\\s/]+/(?:wspace|workspace)/|/home/alan\\b)",
      "flags": "i",
      "description": "developer-local workspace path",
      "excludedPaths": [
        "scripts/check_public_content.sh",
        "scripts/ci/public-release-gate-policy.json"
      ]
    },
    {
      "id": "internal-service-domain",
      "pattern": "(?:[a-z0-9-]+\\.)*silvonastream\\.com\\b",
      "flags": "i",
      "description": "internal service domain",
      "excludedPaths": [
        "packages/types/src/api-config.ts",
        "packages/executor/include/quantnexus/executor/config_types.hpp",
        "plugins/back-test-nexus/backend/data-service.ts",
        "docs/blog/10-multi-source-market-data-providers.md"
      ]
    },
    {
      "id": "internal-ticket",
      "pattern": "\\bTICKET_INTERNAL(?:_[A-Z0-9_]+)?\\b",
      "flags": "",
      "description": "internal-only ticket identifier",
      "excludedPaths": [
        "scripts/check_public_content.sh"
      ]
    },
    {
      "id": "proprietary-notice",
      "pattern": "(?:proprietary\\s+and\\s+confidential|unauthorized\\s+(?:copying|distribution|use))",
      "flags": "i",
      "description": "proprietary distribution notice"
    },
    {
      "id": "known-personal-identifier",
      "pattern": "(?:\\bstarvian\\b|8c5e9aa8-f608-40bc-9b1e-2d042db5c036)",
      "flags": "i",
      "description": "known personal identifier",
      "excludedPaths": [
        "scripts/check_public_content.sh",
        "scripts/ci/public-release-gate-policy.json"
      ]
    },
    {
      "id": "personal-email-address",
      "pattern": "(?<![:/])\\b[a-z0-9._%+-]+@(?!(?:example\\.(?:com|org|net)|test|invalid|localhost|b\\.com|stratcraft\\.ai|stratcraft\\.io|stratcraftsai\\.tech)\\b)[a-z0-9.-]+\\.[a-z]{2,}\\b",
      "flags": "i",
      "description": "non-placeholder email address requiring release review",
      "excludedPaths": [
        "package-lock.json",
        "pnpm-lock.yaml",
        "apps/desktop/src/mcp/standalone/package-lock.json",
        "packages/shared-ui/package-lock.json"
      ]
    },
    {
      "id": "telemetry-ingest-dsn",
      "pattern": "https?://[0-9a-f]{16,}(?::[^@\\s/]+)?@[a-z0-9.-]+",
      "flags": "i",
      "description": "Sentry/GlitchTip-style ingest DSN containing an embedded credential"
    },
    {
      "id": "private-network-url",
      "pattern": "https?://(?:10(?:\\.\\d{1,3}){3}|192\\.168(?:\\.\\d{1,3}){2}|172\\.(?:1[6-9]|2\\d|3[01])(?:\\.\\d{1,3}){2})(?::\\d+)?(?:/|\\b)",
      "flags": "i",
      "description": "private-network service URL",
      "excludedPaths": [
        "apps/desktop/src/mcp/standalone/src/__tests__/net-boundary.1265_6.test.ts"
      ]
    }
  ]
}
