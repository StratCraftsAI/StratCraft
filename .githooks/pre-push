#!/bin/bash
# .githooks/pre-push
# TICKET_471_3: Run regression tests before push to prevent broken code.
# Install with: ./scripts/install_hooks.sh
# Bypass with: git push --no-verify (developer discretion)

set -e

PROJECT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
EXECUTOR_BUILD="${PROJECT_DIR}/packages/executor/build"

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

echo -e "${GREEN}[pre-push]${NC} Running regression checks..."

FAILURES=0

# 1. Run Executor unit tests (if built)
if [ -x "${EXECUTOR_BUILD}/test_executor_core" ]; then
    echo -e "${GREEN}[pre-push]${NC} Running Executor core tests..."
    if ! "${EXECUTOR_BUILD}/test_executor_core" "[regression]" 2>/dev/null; then
        echo -e "${RED}[pre-push]${NC} Executor core tests FAILED"
        FAILURES=$((FAILURES + 1))
    fi
elif [ -x "${EXECUTOR_BUILD}/bin/test_executor_core" ]; then
    echo -e "${GREEN}[pre-push]${NC} Running Executor core tests..."
    if ! "${EXECUTOR_BUILD}/bin/test_executor_core" "[regression]" 2>/dev/null; then
        echo -e "${RED}[pre-push]${NC} Executor core tests FAILED"
        FAILURES=$((FAILURES + 1))
    fi
else
    echo -e "${YELLOW}[pre-push]${NC} Executor tests not built, skipping (run './start.sh executor' first)"
fi

# 2. Run Executor data source tests (if built)
for test_bin in "${EXECUTOR_BUILD}/test_data_source" "${EXECUTOR_BUILD}/bin/test_data_source"; do
    if [ -x "${test_bin}" ]; then
        echo -e "${GREEN}[pre-push]${NC} Running data source tests..."
        if ! "${test_bin}" "[regression]" 2>/dev/null; then
            echo -e "${RED}[pre-push]${NC} Data source tests FAILED"
            FAILURES=$((FAILURES + 1))
        fi
        break
    fi
done

# 3. Run TypeScript type check (fast, catches type errors)
if [ -f "${PROJECT_DIR}/apps/desktop/tsconfig.json" ]; then
    echo -e "${GREEN}[pre-push]${NC} Running TypeScript type check..."
    if command -v npx &>/dev/null; then
        if ! (cd "${PROJECT_DIR}" && npx tsc --noEmit --project apps/desktop/tsconfig.json 2>/dev/null); then
            echo -e "${YELLOW}[pre-push]${NC} TypeScript type check had warnings (non-blocking)"
        fi
    fi
fi

# 4. Run public content compliance check (if pushing to public branches)
REMOTE="$1"
if echo "$REMOTE" | grep -qi "public\|open-source\|oss"; then
    echo -e "${GREEN}[pre-push]${NC} Running public content compliance check..."
    if [ -x "${PROJECT_DIR}/scripts/check_public_content.sh" ]; then
        if ! "${PROJECT_DIR}/scripts/check_public_content.sh"; then
            echo -e "${RED}[pre-push]${NC} Public content compliance check FAILED"
            FAILURES=$((FAILURES + 1))
        fi
    fi
fi

# Summary
echo ""
if [ $FAILURES -gt 0 ]; then
    echo -e "${RED}[pre-push]${NC} ${FAILURES} check(s) failed. Push blocked."
    echo "Use 'git push --no-verify' to bypass (at your own risk)."
    exit 1
fi

echo -e "${GREEN}[pre-push]${NC} All regression checks passed."
exit 0
