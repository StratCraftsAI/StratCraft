# EditorConfig - https://editorconfig.org
# TICKET_636_3: Enforce ASCII-safe editing defaults

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{py,cpp,c,h,hpp}]
indent_size = 4

[*.md]
trim_trailing_whitespace = false
