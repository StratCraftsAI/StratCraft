{
  "name": "StratCraft",
  "version": "0.1.0",
  "private": true,
  "description": "StratCraft - Quantitative Trading Platform",
  "author": "StratCraft Team",
  "homepage": "https://github.com/StratCraftsAI/StratCraft#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/StratCraftsAI/StratCraft.git"
  },
  "bugs": {
    "url": "https://github.com/StratCraftsAI/StratCraft/issues"
  },
  "license": "Apache-2.0",
  "scripts": {
    "dev": "pnpm -r --parallel --no-bail --filter '!@stratcraft/web-dashboard' run dev",
    "dev:all": "pnpm -r --parallel --no-bail run dev",
    "dev:webdash": "bash apps/web-dashboard/start-dev.sh",
    "test:dev-lifecycle": "bash apps/web-dashboard/tests/dev-lifecycle.test.sh",
    "build": "turbo run build --filter=!@StratCraft/plugin-chart",
    "typecheck": "pnpm -r --no-bail --filter='!@StratCraft/desktop' run typecheck",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "clean": "turbo run clean && rm -rf node_modules",
    "dev:desktop": "pnpm --filter @StratCraft/desktop dev",
    "dev:desktop:research": "pnpm --filter @StratCraft/desktop dev:research",
    "dev:server": "pnpm --filter @StratCraft/server dev",
    "build:desktop": "pnpm --filter @StratCraft/desktop build",
    "package:desktop": "pnpm --filter @StratCraft/desktop package",
    "webdash:build": "bash ./start.sh webdash-build",
    "webdash:start": "bash scripts/webdash/start-production.sh",
    "compliance": "STRATCRAFT_PUBLIC_TREE=1 bash scripts/check_public_content.sh && bash scripts/check_license_compliance.sh && bash scripts/check_code_compliance.sh && STRATCRAFT_PUBLIC_TREE=1 bash scripts/check_architecture_rules.sh",
    "compliance:licenses": "bash scripts/check_license_compliance.sh",
    "compliance:content": "bash scripts/check_code_compliance.sh",
    "compliance:architecture": "STRATCRAFT_PUBLIC_TREE=1 bash scripts/check_architecture_rules.sh",
    "ci:bridge-ratchet": "node scripts/ci/bridge-call-site-count.mjs",
    "ci:modern-cpp-boundaries": "node scripts/ci/modern-cpp-boundary-audit.mjs",
    "ci:modern-cpp-phase0": "node scripts/ci/modern-cpp-phase0-evidence.mjs",
    "ci:eval-parquet-schema": "node scripts/ci/eval-parquet-schema-parity.mjs",
    "ci:three-platform-package": "node scripts/ci/three-platform-package-audit.mjs",
    "ci:generated-public-three-platform": "node scripts/ci/generated-public-three-platform.mjs",
    "ci:quant-lab-release": "node --test scripts/ci/__tests__/quant-lab-release-pipeline-audit.test.mjs plugins/quant-lab-nexus/scripts/verify-release-package.test.mjs && node scripts/ci/quant-lab-release-pipeline-audit.mjs",
    "ci:public-release-checklist": "node --test scripts/ci/__tests__/public-release-checklist.test.mjs",
    "i18n:audit": "node scripts/i18n-audit.js",
    "i18n:drift": "bash scripts/i18n/keydiff.sh --strict",
    "i18n:check": "node scripts/i18n/keycheck.mjs --strict",
    "i18n:fallback": "node scripts/i18n/fallback-discipline.mjs --strict",
    "prepare": "husky"
  },
  "devDependencies": {
    "@typescript-eslint/parser": "^8.61.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "husky": "^9.1.0",
    "lint-staged": "^15.2.0",
    "turbo": "^2.3.0",
    "typescript": "^5.3.0"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=22.6.0"
  },
  "optionalDependencies": {
    "@clickhouse/client": "^1.16.0"
  },
  "dependencies": {
    "electron-store": "^11.0.2"
  },
  "pnpm": {
    "overrides": {
      "tar": ">=7.5.11",
      "fast-xml-parser": ">=5.7.0",
      "fast-xml-builder": ">=1.1.7",
      "fast-uri": ">=3.1.5",
      "ws@>=8.0.0": ">=8.21.0",
      "ws@>=5.0.0 <6.0.0": ">=5.2.5",
      "adm-zip": ">=0.6.0",
      "js-yaml@>=4.0.0": ">=4.3.0",
      "builder-util-runtime": ">=9.7.0",
      "@opentelemetry/core@>=2.0.0": ">=2.8.0",
      "minimatch@<3.1.4": ">=3.1.4",
      "minimatch@>=10.0.0": ">=10.2.3",
      "ajv@>=7.0.0-alpha.0 <8.18.0": ">=8.18.0",
      "@tootallnate/once@<3.0.1": ">=3.0.1",
      "brace-expansion@<1.1.13": "~1.1.13",
      "brace-expansion@>=2.0.0 <2.0.3": "~2.0.3",
      "brace-expansion@>=5.0.0": ">=5.0.9",
      "@isaacs/brace-expansion@<=5.0.0": ">=5.0.1",
      "picomatch@<2.3.2": ">=2.3.2",
      "picomatch@>=4.0.0": ">=4.0.4",
      "test-exclude@6>minimatch": "3.1.5",
      "test-exclude@7>minimatch": "9.0.9",
      "thrift>uuid": "^11.1.0"
    },
    "patchedDependencies": {
      "@dsnp/parquetjs@1.8.8": "patches/parquetjs-1-8-8.patch"
    }
  }
}
